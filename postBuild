#!/bin/bash
# Binder runs this after installing requirements.txt: create the .ipynb for
# every notebook script, so they open as notebooks in JupyterLab.
set -euo pipefail
files=$(find . -path ./.git -prune -o -path '*/.ipynb_checkpoints' -prune -o -name '*.py' -print)
if [ -n "$files" ]; then
  jupytext --sync $files
fi
