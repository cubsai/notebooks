# Python environment (managed by uv)
.venv/
__pycache__/

# Notebooks: the paired .py script is tracked; the .ipynb is generated locally.
# Exception: saved copies made with `just snapshot`.
*.ipynb
!**/outputs/*.ipynb
.ipynb_checkpoints/

# Datasets too large for git (note where to get them in the lesson README)
*.large.csv

# macOS
.DS_Store

# MLflow runs (local tracking database and artifacts)
mlflow.db
mlruns/
